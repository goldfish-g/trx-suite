{
  // The converter's worker and tests, with the TRX Level Converter they run
  // (the converter submodule), checked with the converter's own settings: it is
  // not written for noUncheckedIndexedAccess, which the app uses.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/custom/convert/worker.ts", "src/custom/convert/stock.test.ts", "src/custom/convert/font.test.ts"]
}
